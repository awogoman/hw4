<%- include("partials/header", { title }) %>

<section class="card">
  <h2>MLB Teams</h2>
  <p>
    This data comes from the
    <a href="https://statsapi.mlb.com" target="_blank" rel="noopener">
      MLB Stats API
    </a>.
  </p>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } else { %>
    <div class="table-wrapper">
      <table class="table-teams">
        <thead>
          <tr>
            <th>Team</th>
            <th>Abbr</th>
            <th>League</th>
            <th>Division</th>
            <th>Location</th>
          </tr>
        </thead>
        <tbody>
          <% teams.forEach(team => { %>
            <tr>
              <td><%= team.name %></td>
              <td><%= team.abbr %></td>
              <td><%= team.league %></td>
              <td><%= team.division %></td>
              <td><%= team.location %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include("partials/footer") %>
